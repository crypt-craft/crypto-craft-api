# CryptoCraft API - Local Development Environment Variables
# Copy this file to .env for local development

# Application Settings
NODE_ENV=development
PORT=4000

# Database Configuration
# For local development (adjust port if needed)
DATABASE_URL="postgresql://cryptocraft_user:dev_password@localhost:5432/cryptocraft_dev"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Blockchain Configuration
SOLANA_RPC_URL="https://api.devnet.solana.com"
# Leave empty for read-only mode, or add your base64-encoded private key for write operations
SOLANA_PRIVATE_KEY=""

# JWT Configuration
JWT_SECRET="dev_jwt_secret_change_in_production_123456789"

# Pinata Configuration (use JWT preferred per docs)
# For local dev you can paste your test JWT from Pinata.
# Do NOT include the 'Bearer ' prefix.
PINATA_JWT="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hG9SOwozu0Jp5QW9ylx7j49qQJuaQb0eP_QVv9P476A"
# or API key/secret pair for legacy endpoints
# PINATA_API_KEY="pk_..."
# PINATA_API_SECRET="sk_..."

# Rate Limiting
RATE_LIMIT_RPM=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://app.crypto-craft.local"

# Auth Domain (canonical domain included in wallet-sign messages)
AUTH_DOMAIN="app.crypto-craft.local"

# Queue Configuration (Bull/Redis)
BULL_REDIS_URL="redis://localhost:6379"

# API Keys (for production)
# ENCRYPTION_KEY=""
# API_SECRET_KEY=""

# Monitoring (optional)
# NEW_RELIC_LICENSE_KEY=""
# SENTRY_DSN=""
# MinIO (Media uploads for off-chain images)
MINIO_ENDPOINT="media.crypto-craft.net"
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY="u0aevRYWjRHxxIxJBhUG"
MINIO_SECRET_KEY="BUb2ZGMbTZkGZr2X8VIqdLGxyIO8MuMBivP9zTt1"
MINIO_BUCKET="tokens-media"
# Optional explicit public base URL if different from endpoint scheme/pathing
# Example: https://media.crypto-craft.net
MINIO_PUBLIC_BASE_URL="https://media.crypto-craft.net"
MINIO_FALLBACK_PORT=9000
MINIO_FALLBACK_SSL=false