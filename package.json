{
  "name": "cryptocraft-api",
  "version": "1.0.0",
  "description": "GraphQL/REST API platform for business tokenization, token management and airdrop operations on Solana blockchain",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "queue:dev": "ts-node src/queue/workers.ts",
    "worker": "node dist/queue/workers.js",
    "clean": "rm -rf dist && rm -rf node_modules",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.production.yml up --build",
    "prepare": "husky install"
  },
  "keywords": [
    "blockchain",
    "solana",
    "tokens",
    "airdrop",
    "graphql",
    "typescript",
    "crypto",
    "defi"
  ],
  "author": "CryptoCraft Team",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@metaplex-foundation/js": "^0.20.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@prisma/client": "^6.13.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@types/bull": "^4.10.4",
    "apollo-server-express": "^3.13.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.7.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "prisma": "^6.13.0",
    "tweetnacl": "^1.0.3",
    "winston": "^3.17.0",
    "form-data": "^4.0.0",
    "minio": "^8.0.1",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "husky": "^9.0.0",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=8.0.0"
  }
}
